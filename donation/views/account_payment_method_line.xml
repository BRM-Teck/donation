<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_payment_method_line_tree" model="ir.ui.view">
        <field name="name">donation.account.payment.method.line.list</field>
        <field name="model">account.payment.method.line</field>
        <field name="inherit_id" ref="account.view_account_payment_method_line_tree" />
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="donation" optional="hide" widget="boolean_toggle" />
            </field>
        </field>
    </record>

    <!-- account does not ship a form for this model: Odoo then generates one
         with every field in model order. The journal comes first, since the
         available methods and the account depend on it. -->
    <record id="account_payment_method_line_form" model="ir.ui.view">
        <field name="name">donation.account.payment.method.line.form</field>
        <field name="model">account.payment.method.line</field>
        <field name="arch" type="xml">
            <form string="Payment Method">
                <field name="available_payment_method_ids" invisible="1" />
                <field name="default_account_id" invisible="1" />
                <field name="payment_type" invisible="1" />
                <field name="company_id" invisible="1" />
                <sheet>
                    <group>
                        <group>
                            <field
                                name="journal_id"
                                required="1"
                                domain="[('type', 'in', ('bank', 'cash', 'credit'))]"
                                options="{'no_create': True}"
                            />
                            <field
                                name="payment_method_id"
                                invisible="not journal_id"
                                domain="[('payment_type', '=?', context.get('default_payment_type')), ('id', 'in', available_payment_method_ids)]"
                                options="{'no_create': True, 'no_open': True}"
                            />
                            <field name="name" invisible="not payment_method_id" />
                        </group>
                        <group invisible="not payment_method_id">
                            <field name="donation" widget="boolean_toggle" />
                            <field
                                name="payment_account_id"
                                placeholder="Journal account"
                                options="{'no_quick_create': True}"
                                groups="account.group_account_readonly"
                            />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="account_journal_form" model="ir.ui.view">
        <field name="name">donation.account.journal.form</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='inbound_payment_method_line_ids']/list/field[@name='name']"
                position="after"
            >
                <field name="donation" widget="boolean_toggle" />
            </xpath>
        </field>
    </record>

    <!-- When we'll have a search view on account.payment.method.line
            in the account module (!), we'll add a filter on donation
            and, in the action below, we'll replace the domain
    by a default filter on donation payment methods (it will
    make it easier to set donation=True on a payment mode) -->

    <record
        id="account_payment_method_line_donation_action"
        model="ir.actions.act_window"
    >
        <field name="name">Payment Methods</field>
        <field name="res_model">account.payment.method.line</field>
        <field name="view_mode">list,form</field>
        <field
            name="domain"
        >[('payment_type', '=', 'inbound'), ('donation', '=', True)]</field>
        <field
            name="context"
        >{'default_donation': True, 'default_payment_type': 'inbound'}</field>
    </record>
    <menuitem
        id="account_payment_method_line_donation_menu"
        action="account_payment_method_line_donation_action"
        parent="donation_config_donation_menu"
        sequence="20"
    />
</odoo>
